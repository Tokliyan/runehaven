+/* perf.js — the Performance build's two REAL-BROWSER proof gates, which jsdom
+   cannot run: (1) the ground cache is pixel-for-pixel the same picture as the
+   direct path, and (2) it is actually faster. Playwright + Chromium, stubbed
+   Supabase, fully offline, never touches the live database.
+
+   Usage: node debug/perf.js [html] [width] [height]
+
+   Like shot.js, a machine without Playwright or Chromium must print "skipped"
+   and exit 0 rather than throw — the spec's own wording is "If Playwright is
+   missing, say skipped and still run every jsdom gate".
+
+   HOW THE PIXEL GATE IS MADE HONEST. The spec asks for one frame with
+   GROUND_CACHE false and one with it true, time frozen, counting pixels whose
+   channel difference is over 8. Entities and the HUD are not hidden here and
+   they do not need to be, because something stronger is done instead: the
+   page's clock and Math.random are frozen for the whole comparison, so the
+   WHOLE frame is deterministic, and the first thing measured at every camera
+   is the noise floor — two renders with the cache OFF, which must differ by
+   zero pixels. A noise floor of zero is the proof that the clock really is
+   frozen; the cache-on comparison then covers the entities and the lighting
+   too, so a cache that disturbed anything downstream of the ground would be
+   caught as well. The bar stays the spec's 0.5% of the frame.
+
+   HOW THE FRAME RATE IS MEASURED, AND TWO METHODS THAT WERE WRONG.
+   (1) Timing a tight loop of direct render(t) calls is not a frame: nothing
+   forces the canvas to be presented, so Skia defers work the measurement
+   never sees — in this harness a full-screen drawImage timed that way
+   reported 0.00 ms. (2) Counting requestAnimationFrame callbacks over a
+   wall-clock window looks like honest fps and is not, in this browser:
+   CALIBRATED against a known busy-wait injected per frame, the count is a
+   flat ~57 fps for every real cost from 0 to 16 ms and only becomes accurate
+   above ~18 ms. It is not merely clipped but NON-MONOTONE in that band — a
+   cheaper frame can report fewer fps than a dearer one — so any ratio built
+   from two values near or above ~55 fps is noise with a sign. (The
+   --disable-gpu-vsync / --disable-frame-rate-limit flags do not help; they
+   lower the ceiling to ~58 from 60.)
+
+   So the cost of a frame is measured directly, with the raster FORCED: a run
+   of render(t) calls followed by a one-pixel getImageData, which Skia cannot
+   satisfy without flushing everything queued. That number is immune to any
+   frame-rate cap. fps is then reported as 1000 / (render + overhead), where
+   overhead is this page's own measured per-frame cost outside render() —
+   update(), compositing, presentation — taken from a rAF window at the
+   slowest condition available, which is the one place the rAF counter is
+   trustworthy.
+
+   Condition order is COUNTERBALANCED (off-first and on-first alternate) and
+   every condition is measured many times, because a fixed order biases
+   whichever condition runs last by up to 10-30% in this environment — more
+   than the margin this gate adjudicates. Raw samples are printed, not just
+   medians, so saturation or drift is visible rather than hidden. */
+const fs = require('fs'), path = require('path');
+let pw;
+try { pw = require('playwright'); }
+catch (e) {
+  try { pw = require(path.join(require('child_process').execSync('npm root -g').toString().trim(), 'playwright')); }
+  catch (e2) { console.log('skipped: playwright is not available (' + e.message.split('\n')[0] + ')'); process.exit(0); }
+}
+const FILE = path.resolve(process.argv[2] || path.join(__dirname, '..', 'runehaven.html'));
+const VW = Number(process.argv[3] || 1280), VH = Number(process.argv[4] || 720);
+
+const STUB = `
+(function(){
+  const tableData = { world:{seed:123456789,created_at:new Date(Date.now()-864e5*3).toISOString()},
+    mined_nodes:[],players:null,ground_items:[],base_pieces:[],pets:[],account_pins:[] };
+  function chain(t){ const c=new Proxy(function(){},{get(_,p){ if(p==='then'){const d=tableData[t];return r=>r({data:d===undefined?null:d,error:null});} return ()=>c; }, apply(){return c;}}); return c; }
+  window.supabase = { createClient:()=>({ from:t=>chain(t),
+    channel:()=>{const ch={on:()=>ch,subscribe:cb=>{if(cb)setTimeout(()=>cb('SUBSCRIBED'),0);return ch;},send:async()=>{},track:async()=>{},untrack:async()=>{},presenceState:()=>({})};return ch;},
+    removeChannel:()=>{} }) };
+})();`;
+
+const results = [];
+function gate(name, ok) { results.push([name, ok]); }
+
+(async () => {
+  let b;
+  try {
+    b = await pw.chromium.launch({ executablePath: process.env.PW_CHROMIUM || '/opt/pw-browsers/chromium',
+      args: ['--no-sandbox', '--disable-gpu-vsync', '--disable-frame-rate-limit'] });
+  } catch (e) { console.log('skipped: chromium would not launch (' + e.message.split('\n')[0] + ')'); process.exit(0); }
+  const p = await b.newPage({ viewport: { width: VW, height: VH } });
+  const errs = [];
+  p.on('pageerror', e => errs.push('PAGEERR ' + e.message));
+  await p.route('**/*', r => {
+    const u = r.request().url();
+    if (u.startsWith('file:')) return r.continue();
+    if (/supabase-js/.test(u)) return r.fulfill({ contentType: 'application/javascript', body: STUB });
+    return r.abort();
+  });
+  await p.goto('file://' + FILE);
+  await p.waitForTimeout(1200);
+  await p.evaluate(() => {
+    document.querySelectorAll('.class-card')[3].click();
+    document.getElementById('username').value = 'PerfBot';
+    document.getElementById('pinInput').value = '2468';
+    const u = document.getElementById('sbUrl'), k = document.getElementById('sbKey');
+    if (u) u.value = 'https://stub.supabase.co'; if (k) k.value = 'stub-key';
+    document.getElementById('enterBtn').onclick();
+  });
+  await p.waitForFunction(() => document.getElementById('login').style.display === 'none', null, { timeout: 90000 });
+  await p.waitForTimeout(2500);
+  await p.keyboard.press('Escape');
+
+  const info = await p.evaluate(() => debugGroundCache());
+  console.log('viewport ' + VW + 'x' + VH + ' — GC_TILES ' + info.GC_TILES + ', GC_MAX ' + info.GC_MAX +
+              ', GC_BAKE_PER_FRAME ' + info.GC_BAKE_PER_FRAME + ', chunk canvas ' + info.GC_W + 'x' + info.GC_H);
+
+  /* ---- the four cameras the spec names ---------------------------------- */
+  const spots = await p.evaluate(() => {
+    const out = [];
+    out.push(['Spawn', Math.floor(SPAWN.x), Math.floor(SPAWN.y)]);
+    // a coastline: land with water on a side neighbour
+    const wet = t => t === B.WATER || t === B.DEEP || t === B.SHALLOW;
+    let coast = null, forest = null;
+    for (let y = 30; y < N - 30 && !(coast && forest); y += 3) {
+      for (let x = 30; x < N - 30; x += 3) {
+        const b0 = biomeAt(x, y);
+        if (!coast && !wet(b0) && (wet(biomeAt(x + 1, y)) || wet(biomeAt(x, y + 1)) ||
+                                   wet(biomeAt(x - 1, y)) || wet(biomeAt(x, y - 1)))) coast = [x, y];
+        if (!forest && b0 === B.FOREST && (biomeAt(x + 2, y) !== B.FOREST || biomeAt(x, y + 2) !== B.FOREST)) forest = [x, y];
+        if (coast && forest) break;
+      }
+    }
+    if (coast) out.push(['a coastline', coast[0], coast[1]]);
+    out.push(['the volcano rim', Math.floor(VOLCANO.x), Math.floor(VOLCANO.y)]);
+    if (forest) out.push(['a forest edge', forest[0], forest[1]]);
+    /* ⚠️ THE TWO FRAME-RATE CAMERAS ARE PIXEL-CHECKED TOO, and they are the
+       two that most need it. The Colosseum is the ONLY place arenaFloorAt()
+       and drawArenaFloorDetail() paint — the locked Sand/slab/pave tones, the
+       old stain, the raked grain, 1px strokes — which are the most elaborate
+       ground tiles in the file; the Bazaar has its own set-piece ground. A
+       cache that quietly dropped content at either one would be both faster
+       and wrong, and a speed gate on a camera nobody has pixel-checked is a
+       gate that rewards exactly that. */
+    if (typeof COLOSSEUM !== 'undefined' && COLOSSEUM && COLOSSEUM.x)
+      out.push(['the Colosseum (fps camera)', Math.floor(COLOSSEUM.x), Math.floor(COLOSSEUM.y)]);
+    if (typeof BAZAAR !== 'undefined' && BAZAAR && BAZAAR.x)
+      out.push(['the Bazaar (fps camera)', Math.floor(BAZAAR.x), Math.floor(BAZAAR.y)]);
+    return out;
+  });
+
+  const FIXED_T = 123456.7;
+  let worstPct = 0, allZero = true;
+  for (const [name, x, y] of spots) {
+    await p.evaluate(([x, y]) => { me.x = x + 0.5; me.y = y + 0.5; cam.x = me.x; cam.y = me.y; me.diving = false; }, [x, y]);
+    await p.waitForTimeout(900);          // let the game's own loop load the feature window
+    const r = await p.evaluate((T) => {
+      const D = Date.now, P = performance.now, R = Math.random;
+      const dn = Date.now(), pn = performance.now();
+      Date.now = () => dn; performance.now = () => pn; Math.random = () => 0.5;
+      const W = canvas.width, H = canvas.height;
+      const grab = () => ctx.getImageData(0, 0, W, H).data;
+      const diff = (a, c) => { let n = 0;
+        for (let i = 0; i < a.length; i += 4)
+          if (Math.abs(a[i] - c[i]) > 8 || Math.abs(a[i+1] - c[i+1]) > 8 || Math.abs(a[i+2] - c[i+2]) > 8) n++;
+        return n; };
+      try {
+        debugSetGroundCache(false);
+        render(T); const off1 = grab();
+        render(T); const off2 = grab();
+        debugSetGroundCache(true);                   // clears the cache
+        debugGcResetStats();                         // counters measure THIS camera, not the page's history
+        for (let i = 0; i < 80; i++) render(T);      // warm every visible chunk
+        render(T); const on1 = grab();
+        const gc = debugGroundCache();
+        /* One frame's worth of blit, so the overdraw is a measured number:
+           blitPx is reset, one more frame is drawn, and that is the answer. */
+        debugGcResetStats(); render(T);
+        const one = debugGroundCache();
+        return { px: W * H, floor: diff(off1, off2), cached: diff(off1, on1),
+                 size: gc.size, bakes: gc.bakes, blits: gc.blits, direct: gc.direct,
+                 evicted: gc.evicted, maxFrameBakes: gc.maxFrameBakes,
+                 frameBlits: one.blits, frameBands: one.bands, frameBlitPx: one.blitPx,
+                 GC_BAND: gc.GC_BAND, GC_BANDS: gc.GC_BANDS };
+      } finally { Date.now = D; performance.now = P; Math.random = R; debugSetGroundCache(true); }
+    }, FIXED_T);
+    const pct = r.cached / r.px * 100, fpct = r.floor / r.px * 100;
+    console.log(`pixel match @ ${name}: noise floor ${r.floor} px (${fpct.toFixed(4)}%), ` +
+                `cache on vs off ${r.cached} px (${pct.toFixed(4)}%) of ${r.px}; ` +
+                `chunks ${r.size}, bakes ${r.bakes}, evicted ${r.evicted}, max bakes/frame ${r.maxFrameBakes}; ` +
+                `one frame blits ${r.frameBlits} chunks in ${r.frameBands} bands = ${(r.frameBlitPx / 1e6).toFixed(2)}M px ` +
+                `(${(r.frameBlitPx / r.px).toFixed(2)}x the screen)`);
+    gate(`the clock really is frozen — two cache-off renders at ${name} differ by 0 pixels (${r.floor})`, r.floor === 0);
+    gate(`pixel match at ${name}: ${r.cached} px (${pct.toFixed(4)}%) differ by more than 8, bar 0.5%`, pct <= 0.5);
+    gate(`the cache never evicted a chunk it still needed at ${name} (evicted ${r.evicted}, held ${r.size})`, r.evicted === 0);
+    if (r.cached !== 0) allZero = false;
+    if (pct > worstPct) worstPct = pct;
+  }
+  gate('the cached ground is not merely close but IDENTICAL at every camera', allZero);
+
+  /* ---- frame rate, interleaved, median of five ------------------------- */
+  const fpsSpots = await p.evaluate(() => {
+    const o = [];
+    /* COLOSSEUM/BAZAAR are `let ... = {x:0,y:0}` until worldgen places them,
+       so a truthiness test alone would happily measure tile (0,0) — the
+       deep-sea corner of the map — and print "the Colosseum". */
+    if (typeof COLOSSEUM !== 'undefined' && COLOSSEUM && COLOSSEUM.x > 0) o.push(['the Colosseum', Math.floor(COLOSSEUM.x), Math.floor(COLOSSEUM.y)]);
+    if (typeof BAZAAR !== 'undefined' && BAZAAR && BAZAAR.x > 0) o.push(['the Bazaar', Math.floor(BAZAAR.x), Math.floor(BAZAAR.y)]);
+    return o;
+  });
+  for (const [name, x, y] of fpsSpots) {
+    await p.evaluate(([x, y]) => { me.x = x + 0.5; me.y = y + 0.5; cam.x = me.x; cam.y = me.y; }, [x, y]);
+    await p.waitForTimeout(1200);
+    const r = await p.evaluate(async () => {
+      const med = a => { const b = a.slice().sort((p, q) => p - q); const h = b.length >> 1;
+                         return b.length % 2 ? b[h] : (b[h - 1] + b[h]) / 2; };
+      /* One flushed run of frames: Skia cannot answer getImageData without
+         rasterising everything it has queued, so this is real cost. */
+      const flush = () => ctx.getImageData(0, 0, 1, 1);
+      const cost = (n) => { const t0 = performance.now();
+        for (let i = 0; i < n; i++) render(7000 + i * 16.7);
+        flush(); return (performance.now() - t0) / n; };
+      const rafFps = (ms) => new Promise(res => { let k = 0; const t0 = performance.now();
+        const tick = () => { k++; const el = performance.now() - t0;
+          if (el < ms) requestAnimationFrame(tick); else res(k / (el / 1000)); };
+        requestAnimationFrame(tick); });
+      const setMode = on => { debugSetGroundCache(on); cost(on ? 45 : 10); };   // flip, then warm
+      const off = [], on = [];
+      const live = [];
+      for (let s = 0; s < 16; s++) {
+        /* Liveness is read immediately after the CACHED window, not at the
+           end of the iteration — on an on-first iteration the loop ends with
+           the cache off, which is the condition working correctly. */
+        let g;
+        if (s % 2 === 0) { setMode(false); off.push(cost(20)); setMode(true); on.push(cost(20)); g = debugGroundCache(); }
+        else             { setMode(true);  on.push(cost(20));  g = debugGroundCache(); setMode(false); off.push(cost(20)); }
+        live.push({ cache: g.GROUND_CACHE, blits: g.blits, inside: inInterior() });
+      }
+      /* The page's own per-frame cost outside render(), measured where the
+         rAF counter is trustworthy: the DIRECT condition, which is the
+         slowest and therefore well above the counter's ~18ms knee. */
+      setMode(false);
+      const directCost = med([cost(20), cost(20), cost(20)]);
+      const directFps = await rafFps(1500);
+      const overhead = Math.max(0, 1000 / directFps - directCost);
+      setMode(true);
+      const gc = debugGroundCache();
+      return { offMs: med(off), onMs: med(on), offAll: off, onAll: on,
+               overhead, directFps, directCost, size: gc.size, evicted: gc.evicted,
+               blits: gc.blits, cacheLive: gc.GROUND_CACHE, inside: inInterior(),
+               liveBad: live.filter(l => !l.cache || l.inside).length };
+    });
+    const fOff = 1000 / (r.offMs + r.overhead), fOn = 1000 / (r.onMs + r.overhead);
+    const ratio = fOn / fOff;
+    console.log(`frame rate @ ${name}: render cost ${r.offMs.toFixed(2)} ms direct -> ${r.onMs.toFixed(2)} ms cached ` +
+                `(+${r.overhead.toFixed(2)} ms/frame outside render, from ${r.directFps.toFixed(1)} rAF fps at ${r.directCost.toFixed(2)} ms)`);
+    console.log(`   => ${fOff.toFixed(1)} fps -> ${fOn.toFixed(1)} fps, ratio ${ratio.toFixed(2)}x (bar 1.40x)`);
+    console.log(`   direct samples [${r.offAll.map(v => v.toFixed(1)).join(' ')}]`);
+    console.log(`   cached samples [${r.onAll.map(v => v.toFixed(1)).join(' ')}]`);
+    /* A speed number from a frame that was not actually drawing the cached
+       ground is worth nothing, so the conditions are asserted, not assumed. */
+    gate(`the cached condition really was cached at ${name} (cache live, ${r.blits} blits, not in an interior, ${r.liveBad} bad windows)`,
+      r.cacheLive === true && r.blits > 0 && r.inside === false && r.liveBad === 0);
+    gate(`frame rate at ${name}: ${fOn.toFixed(1)} fps cached vs ${fOff.toFixed(1)} direct = ${ratio.toFixed(2)}x, bar 1.40x`, ratio >= 1.4);
+  }
+
+  gate('no page error during the whole run (' + (errs[0] || 'none') + ')', errs.length === 0);
+  await b.close();
+  let ok = true;
+  for (const [n, g] of results) { console.log((g ? 'PASS' : 'FAIL') + ' - ' + n); if (!g) ok = false; }
+  console.log('perf.js: ' + results.filter(r => r[1]).length + ' PASS, ' + results.filter(r => !r[1]).length + ' FAIL');
+  process.exit(ok ? 0 : 1);
+})().catch(e => { console.log('PERF ERROR:', e.stack || e); process.exit(1); });
